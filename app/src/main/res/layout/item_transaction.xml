<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardTransaction"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E6E6E6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTransactionTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHI"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@android:color/transparent"
                android:textColor="#B71C1C" />

            <TextView
                android:id="@+id/tvTransactionAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="10000"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:gravity="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTransactionNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ghi chú"
            android:textSize="14sp"
            android:layout_marginTop="6dp"
            android:textColor="#333333"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvTransactionCategoryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ăn uống"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:textColor="#666666"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvTransactionReceipt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hoa don: Chua co"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:textColor="#1976D2"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/ivTransactionReceipt"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop"
            android:contentDescription="Receipt preview"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvTransactionDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-03-23"
                android:textSize="12sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/tvTransactionWallet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Wallet"
                android:textSize="12sp"
                android:textColor="#888888"
                android:gravity="end" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

